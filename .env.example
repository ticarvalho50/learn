GOOGLE_API_KEY=your_gemini_api_key_here
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Agendador diário (cron_wrapper.sh)
# ---------------------------------------------------------------------------

# Diretório monitorado — onde os arquivos de notícias diários chegam
PODCAST_INPUT_DIR=/caminho/para/data/noticias

# Diretório servido pelo site — onde os áudios são publicados
# O site pode apontar fixamente para latest.wav
PODCAST_AUDIO_DIR=/caminho/para/www/podcast/audio

# Diretório de logs da execução diária
PODCAST_LOG_DIR=/caminho/para/podcastflow/outputs/logs

# Caminho do virtualenv Python
PODCAST_VENV_PATH=/caminho/para/podcastflow/.venv

# Parâmetros opcionais do podcast diário
PODCAST_TONE=informal
PODCAST_DURATION=médio
PODCAST_HOSTS=2
PODCAST_VOICE=pf_dora
PODCAST_SPEED=1.0
